# Target wisper-api instance that the Vite dev server proxies `/wisper/*` to.
# The console always calls same-origin `/wisper/...` paths; Vite strips the
# `/wisper` prefix and forwards to this target (HTTP + WebSocket), avoiding CORS.
#
# wisper-api must be running in its DEV harness (Tunnel:EnableDevEndpoints=true)
# and DB-less is fine — this app only uses the money-free `/dev/leases` surface.
#
# Defaults to http://127.0.0.1:8090 when unset (the port used in the dev-run docs).
VITE_WISPER_TARGET=http://127.0.0.1:8090
